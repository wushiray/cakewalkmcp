  "scripts": {
    "start": "node bin/cakewalk-mcp.js",
    "test": "node run-tests.mjs",
    "test:full": "node run-tests.mjs --full"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.24.1"
  },
  "engines": { "node": ">=18.19.0" },
  "license": "MIT"
}
